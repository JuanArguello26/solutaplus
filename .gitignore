# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma (cliente generado, se reconstruye con `npm run prisma:generate`)
/generated/

# Documento fuente legal entregado por el cliente: se mantiene en local
# como referencia, pero no se versiona.
DOCUMENTO_BASE_LEGAL_INTEGRASOCIAL.docx

# Sistema experto: cuentas reales del equipo (el repositorio es público) y el
# .xlsx que las contiene. Se regeneran con `npm run sistema-experto:generar`.
sistema-experto/usuarios.local.json
sistema-experto/salida/SolutaPLUS_BaseDatos.xlsx
