# Base de datos (Supabase Postgres)
# DATABASE_URL: conexion con pooler (Supavisor, modo transaction) - usada en runtime (serverless), via @prisma/adapter-pg
# DIRECT_URL: conexion via pooler en modo session - usada solo por Prisma Migrate/CLI (compatible con redes IPv4-only)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Sitio
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WhatsApp Business (numero en formato internacional, solo digitos, sin '+')
NEXT_PUBLIC_WHATSAPP_NUMBER="573001234567"

# Empresa
NEXT_PUBLIC_COMPANY_NAME="Nombre de la empresa"
NEXT_PUBLIC_PHONE="3001234567"
NEXT_PUBLIC_EMAIL="contacto@empresa.com"

# Ubicacion (opcional; si NEXT_PUBLIC_ADDRESS o NEXT_PUBLIC_MAPS_EMBED_URL
# no estan definidas, la seccion "Ubicacion" de la landing no se renderiza)
# NEXT_PUBLIC_ADDRESS: texto libre, se muestra tal cual en la seccion y el footer
# NEXT_PUBLIC_ADDRESS_CITY: solo la ciudad, usada en el JSON-LD (addressLocality)
# NEXT_PUBLIC_MAPS_EMBED_URL: URL de Google Maps "Compartir > Insertar un mapa" (para el iframe)
# NEXT_PUBLIC_MAPS_URL: enlace normal de Google Maps (boton "Como llegar")
NEXT_PUBLIC_ADDRESS=""
NEXT_PUBLIC_ADDRESS_CITY=""
NEXT_PUBLIC_MAPS_EMBED_URL=""
NEXT_PUBLIC_MAPS_URL=""

# Precios del catalogo
# Mientras sea distinto de "true", el cotizador funciona igual pero NO muestra
# la cifra al usuario ni la incluye en el mensaje de WhatsApp (los precios del
# seed son datos de ejemplo). Poner "true" solo cuando las tarifas reales del
# cliente esten cargadas en la base de datos.
NEXT_PUBLIC_PRICES_CONFIRMED="false"

# Analitica (opcional, se activa en fases futuras)
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# Panel administrativo (gate MVP sin usuarios - Fase 4)
ADMIN_PASSWORD="cambia-esta-clave"
ADMIN_SESSION_SECRET="genera-un-secreto-aleatorio-de-al-menos-32-caracteres"

# Rate limiting (Upstash Redis - Fase 2)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Observabilidad (Fase 5)
SENTRY_DSN=""
