generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CONTACTED
  PENDING
  AFFILIATED
  NOT_INTERESTED
  CANCELLED
}

model Service {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  description  String?
  icon         String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  plans Plan[]
  leads Lead[]
}

model Plan {
  id             String    @id @default(cuid())
  serviceId      String
  name           String
  description    String?
  estimatedPrice Decimal   @db.Decimal(12, 2)
  currency       String    @default("COP")
  benefits       String[]
  displayOrder   Int       @default(0)
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  leads   Lead[]

  @@unique([serviceId, name])
  @@index([serviceId])
}

model Lead {
  id                String     @id @default(cuid())
  fullName          String
  document          String?
  phone             String
  email             String
  city              String
  serviceId         String
  planId            String?
  estimatedPrice    Decimal?   @db.Decimal(12, 2)
  observations      String?
  status            LeadStatus @default(NEW)
  source            String?
  ipAddress         String?
  userAgent         String?
  consentAcceptedAt DateTime?
  deletedAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  service       Service             @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  plan          Plan?               @relation(fields: [planId], references: [id], onDelete: SetNull)
  statusHistory LeadStatusHistory[]

  @@index([phone])
  @@index([email])
  @@index([createdAt])
  @@index([serviceId])
  @@index([status])
  @@index([city])
  @@index([phone, serviceId, createdAt])
}

model LeadStatusHistory {
  id        String      @id @default(cuid())
  leadId    String
  oldStatus LeadStatus?
  newStatus LeadStatus
  comment   String?
  changedBy String?
  changedAt DateTime    @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}
